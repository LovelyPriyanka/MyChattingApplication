# Copy this file to .env and fill values
PORT=3000
PUBLIC_SERVER_URL=https://mychattingapplication.onrender.com/
DOTENV_OVERRIDE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional backup SMTP provider (recommended for production failover)
SMTP_BACKUP_HOST=
SMTP_BACKUP_PORT=587
SMTP_BACKUP_SECURE=false
SMTP_BACKUP_TLS_REJECT_UNAUTHORIZED=true
SMTP_BACKUP_USER=a72102001@smtp-brevo.com
SMTP_BACKUP_PASS=RyA51rTbNLYFSPWj
SMTP_BACKUP_FROM=reddypriyanka778@gmail.com
SMTP_BACKUP_FROM_NAME=My Secure Chat

# Optional Brevo HTTPS API fallback (works even if SMTP ports are blocked)
BREVO_API_KEY=

ALLOW_OTP_IN_RESPONSE_ON_EMAIL_FAILURE=false

# Optional: message encryption key for MongoDB stored message text.
# Use either 64-char hex (32 bytes) or 32-byte base64 value.
MESSAGE_ENCRYPTION_KEY=
